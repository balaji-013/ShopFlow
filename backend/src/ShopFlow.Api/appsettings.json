{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } },
  "Serilog": { "MinimumLevel": { "Default": "Information", "Override": { "Microsoft": "Warning", "Microsoft.EntityFrameworkCore.Database.Command": "Warning", "System": "Warning" } } },
  "AllowedHosts": "*",
  "ConnectionStrings": { "Default": "" },
  "Jwt": { "Issuer": "shopflow", "Audience": "shopflow-web", "SigningKey": "", "AccessTokenMinutes": 15, "RefreshTokenDays": 7 },
  "Webhooks": { "Secret": "" },
  "Cors": { "Origins": [] },
  "RateLimiting": { "AuthPerMinute": 10, "GlobalPerMinute": 300 },
  "Outbox": { "Enabled": true },
  "Database": { "MigrateOnStartup": false, "Seed": false },
  "Swagger": { "Enabled": false }
}
